# moviepickarr configuration — copy to `.env` and uncomment what you need.
# Everything is optional except TMDB_API_KEY (enrichment is off without it).

# ── Storage ───────────────────────────────────────────────────────────────────
# Path to the SQLite database file (WAL sidecars live next to it). Relative
# paths resolve against the working directory. Default: moviepickarr.db
#DB_FILE=moviepickarr.db
# Before applying pending migrations to an existing DB, a `VACUUM INTO`
# snapshot (<DB_FILE>.vNNN-<timestamp>.backup) is written next to the DB and
# only the newest N are kept. 0 disables backups. Default: 3
#DB_BACKUP_MAX=3

# ── TMDB enrichment ───────────────────────────────────────────────────────────
# Enables posters, cast/crew and metadata-powered stats. Unset = enrichment off.
#TMDB_API_KEY=your_key_here

# ── Auth ──────────────────────────────────────────────────────────────────────
# Break-glass admin seeded on boot (migrate → seed → serve). Onboarding is
# invite-only, so a fresh deploy needs this to get its first admin in. Set all
# three or none. On boot, MPA_ADMIN_NAME is matched against existing member names
# case-insensitively: no match creates a fresh admin, one match adopts that
# member and ensures they're an admin, an ambiguous multi-match is skipped and
# logged. Idempotent and never overwrites an existing password, so it's safe to
# leave set across restarts.
#MPA_ADMIN_NAME=Your Name
#MPA_ADMIN_USERNAME=yourname
#MPA_ADMIN_PASSWORD=change-me-8-to-128-chars

# ── Logging (see docs/LOGGING.md) ─────────────────────────────────────────────
# Minimum level: trace | debug | info | warn | error | fatal. Default: info.
#LOG_LEVEL=info
# Output format: json (default — one structured line per event, for production) |
# console (colourised, human-readable, with file:line — for local dev). Console
# colour auto-disables when stderr is not a terminal (piped to a file, CI).
#LOG_FORMAT=json

# ── Enrichment worker fine-tuning (sensible defaults; rarely changed) ─────────
#TMDB_ENRICH_CAST_LIMIT=15            # cast members stored per movie (0 = all)
#TMDB_ENRICH_REFRESH_INTERVAL=1h      # periodic re-enrich cadence (0 disables)
#TMDB_ENRICH_TTL=720h                 # how stale metadata may get before refresh
#TMDB_ENRICH_MIN_INTERVAL_MS=250      # min gap between TMDB requests
#TMDB_ENRICH_MAX_RETRIES=4            # retry attempts per TMDB request
#TMDB_ENRICH_BACKOFF_MS=500           # base backoff for retries
#TMDB_ENRICH_QUEUE_SIZE=256           # auto-on-add enqueue buffer
#TMDB_ENRICH_BATCH_LIMIT=200          # max candidates fetched per drain
#TMDB_ENRICH_BATCH_DEBOUNCE_MS=500    # quiet window before an enriched-batch flush
#TMDB_ENRICH_BATCH_MAX_WAIT_MS=2000   # ceiling on batch coalescing
